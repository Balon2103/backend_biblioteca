<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Catálogo de Libros</h1>
    <% if current_user.admin? %>
      <%= link_to 'Nuevo Libro', new_book_path, class: 'btn btn-primary' %>
    <% end %>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <%= form_with url: books_path, method: :get, class: "row g-3" do |f| %>
        <div class="col-md-6">
          <%= f.text_field :search, 
              class: "form-control", 
              placeholder: "Buscar por título, autor, ISBN...",
              value: params[:search] %>
        </div>
        <div class="col-md-4">
          <%= f.select :category, 
              options_for_select(@categories, params[:category]), 
              { include_blank: "Todas las categorías" }, 
              class: "form-select" %>
        </div>
        <div class="col-md-2">
          <%= f.submit "Buscar", class: "btn btn-primary w-100" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>Título</th>
          <th>Autor</th>
          <th>ISBN</th>
          <th>Categoría</th>
          <th>Editorial</th>
          <th>Año</th>
          <th>Disponibles</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% if @books.any? %>
          <% @books.each do |book| %>
            <tr>
              <td><%= book.title %></td>
              <td><%= book.author %></td>
              <td><%= book.isbn %></td>
              <td><%= book.category %></td>
              <td><%= book.publisher %></td>
              <td><%= book.publication_year %></td>
              <td><%= book.quantity %></td>
              <td>
                <%= link_to 'Ver', book_path(book), class: 'btn btn-info btn-sm' %>
                <% if current_user.admin? %>
                  <%= link_to 'Editar', edit_book_path(book), class: 'btn btn-warning btn-sm' %>
                  <%= link_to 'Eliminar', book_path(book), 
                      method: :delete, 
                      data: { confirm: '¿Estás seguro?' }, 
                      class: 'btn btn-danger btn-sm' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="8" class="text-center">No se encontraron libros</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div> 